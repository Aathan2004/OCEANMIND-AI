# ── OceanMind AI — frontend configuration ─────────────────────────────────────
# Copy to .env and fill in real values. Never commit the real .env.
# Only VITE_* variables reach the browser — never put a secret in one.

# URL of the Python ML + auth service (server-side only, not exposed to the browser).
ML_SERVICE_URL=http://127.0.0.1:8000

# NOAA CDO token — free key at https://www.ncdc.noaa.gov/cdo-web/token
# This one IS exposed to the browser (the ocean dashboard calls NOAA directly).
# NOAA tokens are free, rate-limited and grant read-only access to public data,
# so that is acceptable; users can also paste their own in the UI. Do not put
# any other credential behind a VITE_ prefix.
VITE_NOAA_API_KEY=

# OpenRouter API key for the Marine AI assistant.
# NOTE: no VITE_ prefix. VITE_* variables are inlined into the browser bundle,
# which would publish this key to every visitor. This one stays server-side.
OPENROUTER_API_KEY=
