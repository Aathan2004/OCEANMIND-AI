# ── OceanMind AI — ML + Auth service configuration ────────────────────────────
# Copy to ml-py/.env and fill in real values. Never commit the real .env.

# REQUIRED. Signing key for JWT access tokens. The service refuses to issue or
# verify tokens without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Access token lifetime in seconds (default 7 days).
JWT_EXPIRES_SECONDS=604800

# SQLite database location (default: ml-py/data/oceanmind.db)
DATABASE_PATH=

# Browser origins allowed to call this service directly.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Marine AI assistant ───────────────────────────────────────────────────────
# The chat assistant is proxied through this service so the key never reaches the
# browser. Without OPENROUTER_API_KEY the Marine AI page reports that it is not
# configured; everything else in the app keeps working.
#
# To enable it:
#   1. Create an account at https://openrouter.ai
#   2. Create a key at https://openrouter.ai/keys
#   3. Paste it below (in ml-py/.env, NOT in the frontend .env)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model id. Verified against https://openrouter.ai/api/v1/models
# Options: deepseek/deepseek-chat, deepseek/deepseek-r1,
#          deepseek/deepseek-chat-v3-0324, deepseek/deepseek-chat-v3.1
OPENROUTER_MODEL=deepseek/deepseek-chat

# Override only if you proxy through a different OpenAI-compatible gateway.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Seconds to wait for the model before returning a timeout message.
AI_REQUEST_TIMEOUT_SECONDS=60

# Used for OpenRouter attribution headers. Not a secret.
PUBLIC_APP_URL=http://localhost:5173

# ── Model / inference ─────────────────────────────────────────────────────────
# Force a torch device: cpu | cuda | mps. Leave blank to auto-detect.
TORCH_DEVICE=

# Open-set rejection. Raise these to return "unknown" more often.
FISH_CONFIDENCE_THRESHOLD=0.45
FISH_MARGIN_THRESHOLD=0.10
FISH_ENTROPY_THRESHOLD=0.55
FISH_BLUR_THRESHOLD=12.0

# Fish / non-fish gate (ImageNet MobileNetV3).
FISH_GATE_ENABLED=true
FISH_GATE_THRESHOLD=0.02
FISH_GATE_AQUATIC_THRESHOLD=0.03
FISH_GATE_VETO=0.75
